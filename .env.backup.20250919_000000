# BackendBot Environment Configuration
# ===================================

# 🔐 ACCESO DIRECTO SEGURO - API KEY PARA BYPASS DE AUTENTICACIÓN
# Esta API key permite acceso directo a todos los endpoints sin OAuth2
# ÚSALO SOLO PARA DESARROLLO LOCAL O SCRIPTS AUTOMATIZADOS
BACKENDBOT_MASTER_API_KEY=bb_master_2024_secure_key_local_only_48732

# 🔐 SEGURIDAD - JWT SECRET KEY
# Clave secreta para tokens JWT (generada automáticamente)
BACKENDBOT_SECRET_KEY=bb_jwt_secret_2024_auto_generated_secure_key_32_chars_min

# 🔐 AUTENTICACIÓN - CREDENCIALES POR DEFECTO
# ⚠️ CAMBIA ESTAS CREDENCIALES EN PRODUCCIÓN
BACKENDBOT_DEFAULT_USERNAME=admin
BACKENDBOT_DEFAULT_PASSWORD=backendbot_secure_2024

# 🌐 API CONFIGURATION
BACKENDBOT_API_HOST=127.0.0.1
BACKENDBOT_API_PORT=48732
BACKENDBOT_API_HTTPS=true
BACKENDBOT_API_WORKERS=1
BACKENDBOT_API_LOG_LEVEL=warning

# 🗄️ DATABASE CONFIGURATION
BACKENDBOT_DATABASE_URL=sqlite:///backendbot.db
BACKENDBOT_DATABASE_POOL_SIZE=5
BACKENDBOT_DATABASE_MAX_OVERFLOW=10

# 📊 MONITORING & LOGGING
BACKENDBOT_LOG_LEVEL=INFO
BACKENDBOT_ENABLE_METRICS=true
BACKENDBOT_METRICS_PORT=9090

# 🤖 BOTS CONFIGURATION
BACKENDBOT_ENABLE_EXTRA_BOTS=true
BACKENDBOT_BOTS_CHECK_INTERVAL=30
BACKENDBOT_BOTS_MAX_RETRIES=3

# 💾 BACKUP CONFIGURATION
BACKENDBOT_BACKUP_ENABLED=true
BACKENDBOT_BACKUP_SCHEDULE=daily
BACKENDBOT_BACKUP_RETENTION_DAYS=30
BACKENDBOT_BACKUP_COMPRESSION=gzip

# ⚡ POWER MANAGEMENT
BACKENDBOT_POWER_AUTO_SWITCH=true
BACKENDBOT_POWER_HIGH_CPU_THRESHOLD=80
BACKENDBOT_POWER_HIGH_MEMORY_THRESHOLD=85
BACKENDBOT_POWER_HIGH_DISK_THRESHOLD=90

# 🔔 NOTIFICATIONS
BACKENDBOT_NOTIFICATIONS_ENABLED=true
BACKENDBOT_NOTIFICATIONS_COOLDOWN_MINUTES=5
BACKENDBOT_NOTIFICATIONS_EMAIL_ENABLED=false
BACKENDBOT_NOTIFICATIONS_EMAIL_SMTP=localhost

# 🔧 DEVELOPMENT SETTINGS
BACKENDBOT_DEBUG=false
BACKENDBOT_RELOAD=false
BACKENDBOT_CORS_ORIGINS=http://127.0.0.1,http://localhost

# 📁 PATHS CONFIGURATION
BACKENDBOT_CONFIG_DIR=config/
BACKENDBOT_LOGS_DIR=logs/
BACKENDBOT_DATA_DIR=data/
BACKENDBOT_BACKUPS_DIR=backups/
BACKENDBOT_CERTS_DIR=certs/

# 🔒 SECURITY SETTINGS
BACKENDBOT_RATE_LIMIT_REQUESTS=100
BACKENDBOT_RATE_LIMIT_WINDOW_MINUTES=1
BACKENDBOT_SESSION_TIMEOUT_MINUTES=30
BACKENDBOT_MAX_LOGIN_ATTEMPTS=5

# 🌐 EXTERNAL INTEGRATIONS (OPCIONAL)
# BACKENDBOT_SLACK_WEBHOOK_URL=
