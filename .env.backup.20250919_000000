# BACKENDBOT_TELEGRAM_BOT_TOKEN=

# 📊 DASHBOARD SETTINGS
BACKENDBOT_DASHBOARD_THEME=dark
BACKENDBOT_DASHBOARD_REFRESH_INTERVAL=5
BACKENDBOT_DASHBOARD_MAX_HISTORY_HOURS=24

# 🧠 AI/ML SETTINGS
BACKENDBOT_LEARNING_ENABLED=true
BACKENDBOT_LEARNING_CONFIDENCE_THRESHOLD=0.7
BACKENDBOT_LEARNING_MAX_PATTERNS=1000