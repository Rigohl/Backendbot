{
  "name": "backendbot-frontend",
  "version": "1.0.0",
  "description": "Frontend components for BackendBot Dashboard",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint components/ services/ utils/ *.js --ext .js",
    "lint:fix": "eslint components/ services/ utils/ *.js --ext .js --fix",
    "dev": "http-server . -p 3000 -c-1 --cors",
    "build": "echo 'Build process would go here'",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "collectCoverageFrom": [
      "components/**/*.js",
      "!components/**/*.test.js",
      "!**/node_modules/**"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@jest/globals": "^29.7.0",
    "babel-jest": "^30.1.2",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sucrase": "^3.35.0"
  }
}