# Configuración de entorno para Backendbot
# Copia este archivo como .env y configura tus valores

# Credenciales de autenticación básica
BACKENDBOT_USERNAME=admin
BACKENDBOT_PASSWORD=password

# Configuración del servidor
HOST=0.0.0.0
PORT=8000

# Configuración de logging
LOG_LEVEL=INFO
LOG_FILE=backend.log

# Configuración de rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Configuración de CORS (orígenes permitidos separados por coma)
CORS_ORIGINS=*

# Configuración de base de datos (opcional)
DATABASE_URL=postgresql://user:password@localhost:5432/backendbot
