# Example environment variables for BackendBot
# Copy this file to `.env` and set real values before running the app or tests.

# API
BACKENDBOT_API_HOST=127.0.0.1
BACKENDBOT_API_PORT=8000

# Database (local SQLite recommended for development)
BACKENDBOT_DATABASE_URL=sqlite:///data/backendbot.db

# Feature flags
BACKENDBOT_ENABLE_METRICS=false
BACKENDBOT_ENABLE_EXTRA_BOTS=false

# Optional keys (set only if you use API auth or integrations)
BACKENDBOT_MASTER_API_KEY=

# Logging / debug
BACKENDBOT_LOG_LEVEL=INFO
# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database

# Application Configuration
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-secret-key-here

# Railway automatically provides these
PORT=8000
RAILWAY_STATIC_URL=
RAILWAY_ENVIRONMENT=

# Optional: API Keys for external services
API_KEY=your-api-key-here

# Logging
LOG_LEVEL=INFO