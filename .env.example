# BackendBot Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in the values.
#
# - Comments are denoted by a '#' at the start of the line.
# - JSON strings MUST be enclosed in single quotes (''').
# -----------------------------------------------------------------------------

# --- Security ---
# Generate a secure secret key for API access.
# Example: openssl rand -hex 32
API_KEY="your-super-secret-api-key-goes-here"

# --- Operational Mode ---
# Defines the current mode for process management.
# Options: "diario", "videojuego", "editor", "streaming", "multimedia"
MODO="diario"

# --- Performance Thresholds ---
# CPU threshold (in %) to trigger process management.
CPU_THRESHOLD=80
# RAM threshold (in MB) to trigger process management.
RAM_THRESHOLD=4000
# Interval (in seconds) for checking system metrics.
CHECK_TIME=60

# --- Database ---
# Connection string for the database.
# Default is a SQLite database in the 'data' directory.
# For PostgreSQL (e.g., Neon): DATABASE_URL="postgresql://user:password@host:port/dbname"
DATABASE_URL="sqlite:///c:/Users/DELL/Desktop/BackendBot/data/backend_data.db"

# --- Process Management (JSON Strings) ---
# The following variables are JSON strings. Be careful with syntax.

# Processes that can be suspended/hibernated.
HIBERNABLES='["Discord.exe", "Steam.exe", "RiotClientServices.exe"]'

# Processes to close based on the operational mode.
PROCESOS_A_CERRAR='{"videojuego":["Discord.exe","Steam.exe","RiotClientServices.exe","chrome.exe","firefox.exe","msedge.exe","spotify.exe","vlc.exe"],"editor":["chrome.exe","firefox.exe","msedge.exe","discord.exe","steam.exe"],"diario":["Code.exe","Code - Insiders.exe","electron.exe","github.exe","copilot.exe","cmd.exe","powershell.exe"],"streaming":["Code.exe","Steam.exe","Guild Wars 2.exe","DaVinci Resolve.exe","Visual Studio.exe","CMake.exe","Cheat Engine.exe"],"multimedia":["Guild Wars 2.exe","Steam.exe","Discord.exe","chrome.exe","firefox.exe","msedge.exe","OBS.exe","Spotify.exe"]}'

# Important processes that should never be terminated automatically.
PROCESOS_IMPORTANTES='["explorer.exe","obs.exe","DaVinci Resolve.exe","Fairlight.exe","chrome.exe","firefox.exe","msedge.exe","Discord.exe","Spotify.exe"]'

# --- Watchdog Thresholds ---
# Number of times a process can be suspended before being ignored by the watchdog.
SUSPENSION_THRESHOLD=3
# Number of times a process can be rejected for an action before being ignored.
REJECTION_THRESHOLD=3