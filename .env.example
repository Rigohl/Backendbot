# BackendBot Environment Variables for Railway Deployment
# -----------------------------------------------------------------------------
# This is a template file. Copy it to .env and fill in the secret values.
# In Railway, these should be set in the "Variables" tab for your service.
#
# Railway automatically provides the following variables if you link the services:
# - DATABASE_URL (from your PostgreSQL service)
# - REDIS_URL (from your Redis service)
# - PORT (the port your service should listen on)
# -----------------------------------------------------------------------------

# --- Core Settings ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- Security ---
# Generate a secure secret key for API access (e.g., openssl rand -hex 32)
API_KEY="your-super-secret-api-key-goes-here"

# Secret for verifying incoming webhooks from Railway. Create a strong random string.
RAILWAY_WEBHOOK_SECRET="your-railway-webhook-secret-goes-here"

# Admin user credentials for dashboard access
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="backendbot2025!"

# --- External APIs ---
# Only fill in the AI services you intend to use.
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Local Overrides (for local development only) ---
# The following variables are typically for local testing and should not be set in Railway,
# as Railway provides them automatically. Uncomment and use them for local runs.
#
# DATABASE_URL="postgresql://user:password@host:port/database"
# REDIS_URL="redis://localhost:6379"
# PORT=8000

# --- Performance & Process Management (Primarily for local use) ---
# These settings are for the local process management feature and may have
# less effect in a containerized Railway environment.

MODO="diario"
CPU_THRESHOLD=80
RAM_THRESHOLD=4000
CHECK_TIME=60
HIBERNABLES='["Discord.exe", "Steam.exe", "RiotClientServices.exe"]'
PROCESOS_A_CERRAR='{"videojuego":["Discord.exe","Steam.exe","RiotClientServices.exe","chrome.exe","firefox.exe","msedge.exe","spotify.exe","vlc.exe"],"editor":["chrome.exe","firefox.exe","msedge.exe","discord.exe","steam.exe"],"diario":["Code.exe","Code - Insiders.exe","electron.exe","github.exe","copilot.exe","cmd.exe","powershell.exe"],"streaming":["Code.exe","Steam.exe","Guild Wars 2.exe","DaVinci Resolve.exe","Visual Studio.exe","CMake.exe","Cheat Engine.exe"],"multimedia":["Guild Wars 2.exe","Steam.exe","Discord.exe","chrome.exe","firefox.exe","msedge.exe","OBS.exe","Spotify.exe"]}'
PROCESOS_IMPORTANTES='["explorer.exe","obs.exe","DaVinci Resolve.exe","Fairlight.exe","chrome.exe","firefox.exe","msedge.exe","Discord.exe","Spotify.exe"]'
SUSPENSION_THRESHOLD=3
REJECTION_THRESHOLD=3